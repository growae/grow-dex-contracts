@compiler >= 8

include "../../contracts/lib/LiquidityMath.aes"

main contract LiquidityMathTest =
    entrypoint get_delta_amount_0(sqrt_price_a: int, sqrt_price_b: int, liquidity: int, round_up: bool) : int =
        LiquidityMath.get_delta_amount_0(sqrt_price_a, sqrt_price_b, liquidity, round_up)

    entrypoint get_delta_amount_1(sqrt_price_a: int, sqrt_price_b: int, liquidity: int, round_up: bool) : int =
        LiquidityMath.get_delta_amount_1(sqrt_price_a, sqrt_price_b, liquidity, round_up)

    entrypoint get_liquidity_from_amount_0(sqrt_price_a: int, sqrt_price_b: int, amount: int) : int =
        LiquidityMath.get_liquidity_from_amount_0(sqrt_price_a, sqrt_price_b, amount)

    entrypoint get_liquidity_from_amount_1(sqrt_price_a: int, sqrt_price_b: int, amount: int) : int =
        LiquidityMath.get_liquidity_from_amount_1(sqrt_price_a, sqrt_price_b, amount)

    entrypoint get_liquidity_from_amounts(sqrt_price: int, sqrt_price_a: int, sqrt_price_b: int, amount_0: int, amount_1: int) : int =
        LiquidityMath.get_liquidity_from_amounts(sqrt_price, sqrt_price_a, sqrt_price_b, amount_0, amount_1)

    entrypoint add_delta(liquidity: int, delta: int) : int =
        LiquidityMath.add_delta(liquidity, delta)

    entrypoint get_next_sqrt_price_from_amount_0(sqrt_price: int, liquidity: int, amount: int, add: bool) : int =
        LiquidityMath.get_next_sqrt_price_from_amount_0(sqrt_price, liquidity, amount, add)

    entrypoint get_next_sqrt_price_from_amount_1(sqrt_price: int, liquidity: int, amount: int, add: bool) : int =
        LiquidityMath.get_next_sqrt_price_from_amount_1(sqrt_price, liquidity, amount, add)
