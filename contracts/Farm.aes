@compiler >= 8

include "Option.aes"
include "./interfaces/IAEX9.aes"
include "./lib/Math.aes"

main contract Farm =
    let q64 = 18446744073709551616

    record farm_pool = {
        lp_token             : IAEX9,
        reward_token         : IAEX9,
        reward_per_second    : int,
        start_time           : int,
        end_time             : int,
        last_update_time     : int,
        acc_reward_per_share : int,
        total_staked         : int
        }

    record user_info = {
        staked_amount : int,
        reward_debt   : int
        }

    record state = {
        admin        : address,
        farms        : map(int, farm_pool),
        user_stakes  : map(int * address, user_info),
        next_farm_id : int
        }

    datatype event
        = FarmCreated(int, IAEX9, int)
        | Deposited(int, address, int)
        | Withdrawn(int, address, int)
        | RewardClaimed(int, address, int)
        | FarmFunded(int, int)

    entrypoint init() = {
        admin = Call.caller,
        farms = {},
        user_stakes = {},
        next_farm_id = 0
        }

    entrypoint admin() : address = state.admin
    entrypoint get_farm(farm_id: int) : farm_pool =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        state.farms[farm_id]

    entrypoint get_user_info(farm_id: int, user: address) : user_info =
        Map.lookup_default((farm_id, user), state.user_stakes, { staked_amount = 0, reward_debt = 0 })

    // Read-only: projects unclaimed reward using current time and accumulator
    entrypoint pending_reward(farm_id: int, user: address) : int =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        let farm = state.farms[farm_id]
        let ui = get_user_info(farm_id, user)
        if(ui.staked_amount == 0)
            0
        else
            compute_pending(farm, ui)

    // Registers a new reward pool with LP/reward tokens, emission rate, and time window
    stateful entrypoint create_farm(
            lp_token: IAEX9,
            reward_token: IAEX9,
            reward_per_second: int,
            start_time: int,
            end_time: int
        ) : int =
        require(Call.caller == state.admin, "UNAUTHORIZED")
        require(end_time > start_time, "INVALID_TIME_RANGE")
        require(reward_per_second > 0, "ZERO_REWARD_RATE")
        let farm_id = state.next_farm_id
        let farm = {
            lp_token = lp_token,
            reward_token = reward_token,
            reward_per_second = reward_per_second,
            start_time = start_time,
            end_time = end_time,
            last_update_time = start_time,
            acc_reward_per_share = 0,
            total_staked = 0
            }
        put(state { farms[farm_id] = farm, next_farm_id = farm_id + 1 })
        Chain.event(FarmCreated(farm_id, lp_token, reward_per_second))
        farm_id

    // Transfers reward tokens into the farm contract to fund future distributions
    stateful entrypoint fund_farm(farm_id: int, amount: int) : unit =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        require(amount > 0, "ZERO_AMOUNT")
        let farm = state.farms[farm_id]
        farm.reward_token.transfer_allowance(Call.caller, Contract.address, amount)
        Chain.event(FarmFunded(farm_id, amount))

    // Stakes LP tokens into a farm, auto-claiming any pending reward first
    stateful entrypoint deposit(farm_id: int, amount: int) : unit =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        require(amount > 0, "ZERO_AMOUNT")
        update_farm(farm_id)
        let farm = state.farms[farm_id]
        let ui = get_user_info(farm_id, Call.caller)

        if(ui.staked_amount > 0)
            let pending = ui.staked_amount * farm.acc_reward_per_share / q64 - ui.reward_debt
            if(pending > 0)
                farm.reward_token.transfer(Call.caller, pending)
                Chain.event(RewardClaimed(farm_id, Call.caller, pending))

        farm.lp_token.transfer_allowance(Call.caller, Contract.address, amount)

        let new_staked = ui.staked_amount + amount
        let updated_farm = state.farms[farm_id]
        put(state {
            farms[farm_id] = updated_farm { total_staked = updated_farm.total_staked + amount },
            user_stakes[(farm_id, Call.caller)] = {
                staked_amount = new_staked,
                reward_debt = new_staked * updated_farm.acc_reward_per_share / q64
                }
            })
        Chain.event(Deposited(farm_id, Call.caller, amount))

    // Unstakes LP tokens from a farm, auto-claiming any pending reward first
    stateful entrypoint withdraw(farm_id: int, amount: int) : unit =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        require(amount > 0, "ZERO_AMOUNT")
        update_farm(farm_id)
        let farm = state.farms[farm_id]
        let ui = get_user_info(farm_id, Call.caller)
        require(ui.staked_amount >= amount, "INSUFFICIENT_STAKE")

        let pending = ui.staked_amount * farm.acc_reward_per_share / q64 - ui.reward_debt
        if(pending > 0)
            farm.reward_token.transfer(Call.caller, pending)
            Chain.event(RewardClaimed(farm_id, Call.caller, pending))

        farm.lp_token.transfer(Call.caller, amount)

        let new_staked = ui.staked_amount - amount
        let updated_farm = state.farms[farm_id]
        put(state {
            farms[farm_id] = updated_farm { total_staked = updated_farm.total_staked - amount },
            user_stakes[(farm_id, Call.caller)] = {
                staked_amount = new_staked,
                reward_debt = new_staked * updated_farm.acc_reward_per_share / q64
                }
            })
        Chain.event(Withdrawn(farm_id, Call.caller, amount))

    // Harvests accrued reward without changing stake amount
    stateful entrypoint claim(farm_id: int) : int =
        require(Map.member(farm_id, state.farms), "FARM_NOT_FOUND")
        update_farm(farm_id)
        let farm = state.farms[farm_id]
        let ui = get_user_info(farm_id, Call.caller)
        require(ui.staked_amount > 0, "NO_STAKE")

        let pending = ui.staked_amount * farm.acc_reward_per_share / q64 - ui.reward_debt
        if(pending > 0)
            farm.reward_token.transfer(Call.caller, pending)

        put(state {
            user_stakes[(farm_id, Call.caller)] = ui {
                reward_debt = ui.staked_amount * farm.acc_reward_per_share / q64
                }
            })
        Chain.event(RewardClaimed(farm_id, Call.caller, pending))
        pending

    // MasterChef-style: accrues reward-per-share based on elapsed time and total staked
    stateful function update_farm(farm_id: int) : unit =
        let farm = state.farms[farm_id]
        let current_time = Math.min(Chain.timestamp, farm.end_time)
        if(current_time > farm.last_update_time)
            let time_elapsed = current_time - farm.last_update_time
            let extra = if(farm.total_staked > 0) time_elapsed * farm.reward_per_second * q64 / farm.total_staked else 0
            let new_acc = farm.acc_reward_per_share + extra
            put(state { farms[farm_id] = farm { acc_reward_per_share = new_acc, last_update_time = current_time } })

    // Pure calculation: simulates update_farm + reward formula without state changes
    function compute_pending(farm: farm_pool, ui: user_info) : int =
        let current_time = Math.min(Chain.timestamp, farm.end_time)
        let time_elapsed = if(current_time > farm.last_update_time) current_time - farm.last_update_time else 0
        let extra_reward = if(farm.total_staked > 0 && time_elapsed > 0) time_elapsed * farm.reward_per_second * q64 / farm.total_staked else 0
        let acc = farm.acc_reward_per_share + extra_reward
        ui.staked_amount * acc / q64 - ui.reward_debt
