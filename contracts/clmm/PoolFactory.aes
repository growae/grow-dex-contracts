@compiler >= 8

include "../interfaces/IAEX9.aes"
include "../interfaces/IDexConfig.aes"
include "./Pool.aes"

main contract PoolFactory =
    record state = {
        admin       : address,
        config      : IDexConfig,
        pool_model  : Pool,
        pools       : map(address * address * int, Pool),
        all_pools   : list(Pool)
    }

    datatype event
        = PoolCreated(IAEX9, IAEX9, Pool, int)

    entrypoint init(config: IDexConfig, pool_model: Pool) = {
        admin = Call.caller,
        config = config,
        pool_model = pool_model,
        pools = {},
        all_pools = []
    }

    entrypoint get_pool(token_a: IAEX9, token_b: IAEX9, config_index: int) : option(Pool) =
        let (t0, t1) = sort_tokens(token_a, token_b)
        Map.lookup((t0.address, t1.address, config_index), state.pools)

    entrypoint all_pools() : list(Pool) = state.all_pools
    entrypoint all_pools_length() : int = List.length(state.all_pools)

    payable stateful entrypoint create_pool(
            token_a: IAEX9,
            token_b: IAEX9,
            config_index: int,
            initial_sqrt_price: int,
            open_time: int
        ) : Pool =
        require(token_a.address != token_b.address, "IDENTICAL_TOKENS")
        let (t0, t1) = sort_tokens(token_a, token_b)
        require(!Map.member((t0.address, t1.address, config_index), state.pools), "POOL_EXISTS")

        let fee_cfg = state.config.get_config(config_index)
        require(!fee_cfg.disabled, "CONFIG_DISABLED")
        require(fee_cfg.tick_spacing > 0, "INVALID_TICK_SPACING")

        if(fee_cfg.create_pool_fee > 0)
            require(Call.value >= fee_cfg.create_pool_fee, "INSUFFICIENT_POOL_FEE")
            Chain.spend(state.admin, fee_cfg.create_pool_fee)
            let refund = Call.value - fee_cfg.create_pool_fee
            if(refund > 0) Chain.spend(Call.caller, refund)

        let pool : Pool = Chain.clone(
            ref = state.pool_model,
            state.config,
            config_index,
            t0, t1,
            fee_cfg.tick_spacing,
            initial_sqrt_price,
            Call.caller,
            open_time)

        put(state { pools[(t0.address, t1.address, config_index)] = pool,
                    all_pools = pool :: state.all_pools })
        Chain.event(PoolCreated(t0, t1, pool, fee_cfg.tick_spacing))
        pool

    function sort_tokens(a: IAEX9, b: IAEX9) : (IAEX9 * IAEX9) =
        if(a.address < b.address) (a, b) else (b, a)
