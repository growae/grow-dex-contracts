@compiler >= 8

include "./IAEX9.aes"
include "./IDexConfig.aes"

contract interface IPool =
    entrypoint init : (IDexConfig, int, IAEX9, IAEX9, int, int, address, int) => unit
    entrypoint token_0 : () => IAEX9
    entrypoint token_1 : () => IAEX9
    entrypoint sqrt_price_x64 : () => int
    entrypoint tick_current : () => int
    entrypoint liquidity : () => int
    entrypoint get_status : () => int
