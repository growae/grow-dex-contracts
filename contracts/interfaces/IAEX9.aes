// AEX-9 Fungible Token Standard interface
// See: https://github.com/aeternity/AEXs/blob/master/AEXS/aex-9.md
@compiler >= 8

contract interface IAEX9 =
    // Token metadata: name, symbol, and decimal precision
    record meta_info = { name: string, symbol: string, decimals: int }
    // Identifies a spender allowance: who granted it and who may spend it
    record allowance_accounts = { from_account: address, for_account: address }
    // Returns token name, symbol, and decimals
    entrypoint meta_info : () => meta_info
    // Returns the total number of tokens in circulation
    entrypoint total_supply : () => int
    // Returns the balance of the given account, or None if never seen
    entrypoint balance : (address) => option(int)
    // Returns the remaining allowance for the given from/for account pair
    entrypoint allowance : (allowance_accounts) => option(int)
    // Transfers `amount` tokens from caller to `recipient`
    stateful entrypoint transfer : (address, int) => unit
    // Grants `spender` permission to spend up to `amount` of caller's tokens
    stateful entrypoint create_allowance : (address, int) => unit
    // Adjusts the existing allowance for `spender` by a signed `delta`
    stateful entrypoint change_allowance : (address, int) => unit
    // Transfers `amount` from `from` to `to`, consuming `from`'s allowance for caller
    stateful entrypoint transfer_allowance : (address, address, int) => unit
