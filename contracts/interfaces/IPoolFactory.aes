@compiler >= 8

include "./IAEX9.aes"
include "./IPool.aes"

contract interface IPoolFactory =
    entrypoint get_pool : (IAEX9, IAEX9, int) => option(IPool)
    entrypoint pool_count : () => int
    entrypoint get_pool_at : (int) => IPool
    entrypoint get_pools : (int, int) => list(IPool)
    stateful entrypoint create_pool : (IAEX9, IAEX9, int, int, int) => IPool
