@compiler >= 8

namespace Oracle =
    let observation_num = 100
    let observation_update_duration = 15

    record observation = {
        block_timestamp    : int,
        cumulative_price_0 : int,
        cumulative_price_1 : int
        }

    function default_observation() : observation =
        { block_timestamp = 0, cumulative_price_0 = 0, cumulative_price_1 = 0 }

    function update(
            last_obs: observation,
            current_timestamp: int,
            price_0_x32: int,
            price_1_x32: int
        ) : (observation * bool) =
        let time_delta = current_timestamp - last_obs.block_timestamp
        if(time_delta == 0)
            (last_obs, false)
        else
            let new_cumulative_0 = last_obs.cumulative_price_0 + price_0_x32 * time_delta
            let new_cumulative_1 = last_obs.cumulative_price_1 + price_1_x32 * time_delta
            let updated = {
                block_timestamp = current_timestamp,
                cumulative_price_0 = new_cumulative_0,
                cumulative_price_1 = new_cumulative_1
                }
            let advance = time_delta >= observation_update_duration
            (updated, advance)

    function get_twap_price_x32(obs_old: observation, obs_new: observation) : (int * int) =
        let time_delta = obs_new.block_timestamp - obs_old.block_timestamp
        require(time_delta > 0, "ORACLE_NO_TIME_DELTA")
        let twap_0 = (obs_new.cumulative_price_0 - obs_old.cumulative_price_0) / time_delta
        let twap_1 = (obs_new.cumulative_price_1 - obs_old.cumulative_price_1) / time_delta
        (twap_0, twap_1)
